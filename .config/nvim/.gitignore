# Local overrides and private configurations
local/
lua/config/local.lua
lua/plugins/local.lua
lua/plugins/local/
.env
.env.*
!.env.example
.direnv/
.secrets*
*.pem
*.key

# System and editor temporary files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Note: lazy-lock.json and lazyvim.json should be committed to reproduce plugin versions and LazyVim configurations.
