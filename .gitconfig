[user]
	name = lycorlaptop
	email = elst.george7@gmail.com

[color]
  ui = auto

[alias]
  co = checkout
  br = branch
  ad = add
  st = status -s
  ls = ls-files
  ci = commit

  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) <%an>%Creset' --abbrev-commit

  pu = pull
  ps = push
