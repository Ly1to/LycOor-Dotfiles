[init]
  defaultBranch = main

[include]
  path = ~/.gitconfig.local

[pull]
  # 同步只走 rebase，避免产生 Merge branch 节点
  rebase = true

[fetch]
  # 自动清理上游已删除的分支的远程跟踪 ref
  prune = true

[color]
  ui = auto

[alias]
  co = checkout
  br = branch
  sw = switch
  cp = cherry-pick

  ad = add
  st = status -s
  ls = ls-files
  df = diff
  ci = commit

  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) <%an>%Creset' --abbrev-commit

  pu = pull
  ps = push
